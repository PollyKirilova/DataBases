import React, { useState } from 'react';
import { Calculator, Sigma, TrendingUp, Hash, ArrowDown, ArrowUp, Play, Database, BookOpen, Code, AlertCircle } from 'lucide-react';

const App = () => {
  const [activeTab, setActiveTab] = useState('theory');
  const [queryResult, setQueryResult] = useState(null);
  const [selectedFunc, setSelectedFunc] = useState(null);

  const inventory = [
    { id: 1, name: 'Лаптоп Pro', category: 'Електроника', price: 2500, stock: 15 },
    { id: 2, name: 'Мишка Wireless', category: 'Аксесоари', price: 45, stock: 120 },
    { id: 3, name: 'Монитор 27"', category: 'Електроника', price: 600, stock: 8 },
    { id: 4, name: 'Клавиатура RGB', category: 'Аксесоари', price: 120, stock: 45 },
    { id: 5, name: 'Слушалки', category: 'Аудио', price: 180, stock: 30 }
  ];

  const functions = [
    { 
      name: 'COUNT', 
      icon: <Hash size={20} />, 
      desc: 'Брои редовете или ненулевите стойности.', 
      syntax: 'SELECT COUNT(column_name) FROM table;',
      details: 'COUNT(*) брои всички редове, включително тези с NULL. COUNT(column) брои само редовете, където колоната не е NULL.',
      sql: 'SELECT COUNT(*) FROM products;' 
    },
    { 
      name: 'SUM', 
      icon: <Sigma size={20} />, 
      desc: 'Пресмята общата сума на числова колона.', 
      syntax: 'SELECT SUM(column_name) FROM table;',
      details: 'Работи само с числови типове данни. Игнорира NULL стойностите автоматично.',
      sql: 'SELECT SUM(stock) FROM products;' 
    },
    { 
      name: 'AVG', 
      icon: <TrendingUp size={20} />, 
      desc: 'Изчислява средноаритметичната стойност.', 
      syntax: 'SELECT AVG(column_name) FROM table;',
      details: 'Изчислява се като SUM(column) / COUNT(column). NULL стойностите не влизат в делението!',
      sql: 'SELECT AVG(price) FROM products;' 
    },
    { 
      name: 'MIN', 
      icon: <ArrowDown size={20} />, 
      desc: 'Намира минималната стойност в набора.', 
      syntax: 'SELECT MIN(column_name) FROM table;',
      details: 'Може да работи и с текстови данни (връща първата по азбучен ред) и дати.',
      sql: 'SELECT MIN(price) FROM products;' 
    },
    { 
      name: 'MAX', 
      icon: <ArrowUp size={20} />, 
      desc: 'Намира максималната стойност в набора.', 
      syntax: 'SELECT MAX(column_name) FROM table;',
      details: 'Може да се ползва за намиране на най-новата дата или последната буква в азбуката.',
      sql: 'SELECT MAX(price) FROM products;' 
    }
  ];

  const runExample = (funcName) => {
    setSelectedFunc(funcName);
    const funcObj = functions.find(f => f.name === funcName);
    let result;
    const prices = inventory.map(p => p.price);
    const stocks = inventory.map(p => p.stock);

    switch (funcName) {
      case 'COUNT': result = inventory.length; break;
      case 'SUM': result = stocks.reduce((a, b) => a + b, 0); break;
      case 'AVG': result = (prices.reduce((a, b) => a + b, 0) / prices.length).toFixed(2); break;
      case 'MIN': result = Math.min(...prices); break;
      case 'MAX': result = Math.max(...prices); break;
      default: result = 0;
    }
    setQueryResult({ val: result, syntax: funcObj.syntax, sql: funcObj.sql });
  };

  return (
    <div className="min-h-screen bg-slate-50 font-sans text-slate-800 p-4 md:p-8">
      <header className="max-w-6xl mx-auto mb-10">
        <div className="flex items-center gap-4 mb-4">
          <div className="bg-indigo-600 p-3 rounded-2xl shadow-lg shadow-indigo-200">
            <Calculator className="text-white w-8 h-8" />
          </div>
          <div>
            <h1 className="text-3xl font-bold text-slate-900 tracking-tight">SQL Агрегиращи функции</h1>
            <p className="text-slate-500 font-medium italic">Анализ на данни и статистика</p>
          </div>
        </div>
        
        <div className="flex gap-2 p-1 bg-slate-200 w-fit rounded-xl">
          <button 
            onClick={() => setActiveTab('theory')}
            className={`px-6 py-2 rounded-lg font-bold transition-all ${activeTab === 'theory' ? 'bg-white text-indigo-600 shadow-sm' : 'text-slate-600 hover:text-slate-900'}`}
          >
            Урок & Синтаксис
          </button>
          <button 
            onClick={() => setActiveTab('lab')}
            className={`px-6 py-2 rounded-lg font-bold transition-all ${activeTab === 'lab' ? 'bg-white text-indigo-600 shadow-sm' : 'text-slate-600 hover:text-slate-900'}`}
          >
            Интерактивна Лаборатория
          </button>
        </div>
      </header>

      <main className="max-w-6xl mx-auto">
        {activeTab === 'theory' ? (
          <div className="space-y-8 animate-in fade-in duration-500">
            <section className="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                <h2 className="text-xl font-bold mb-4 flex items-center gap-2">
                  <BookOpen className="text-indigo-600" size={24} />
                  Какво превръща редовете в статистика?
                </h2>
                <p className="text-slate-600 leading-relaxed mb-4">
                  Агрегиращите функции обработват множество записи и връщат <strong>един единствен резултат</strong>. Те са "двигателят" на бизнес анализите и отчетите.
                </p>
                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                  {functions.map(f => (
                    <div key={f.name} className="p-5 bg-slate-50 rounded-xl border border-slate-100 hover:shadow-md transition-all">
                      <div className="flex items-center gap-2 mb-3">
                        <div className="text-indigo-600">{f.icon}</div>
                        <h3 className="font-black text-lg tracking-wider">{f.name}()</h3>
                      </div>
                      <div className="bg-slate-900 p-3 rounded-lg mb-3">
                        <code className="text-pink-400 text-xs font-mono break-all">{f.syntax}</code>
                      </div>
                      <p className="text-sm text-slate-600 mb-2 font-semibold">{f.desc}</p>
                      <p className="text-xs text-slate-500 leading-tight">{f.details}</p>
                    </div>
                  ))}
                </div>
            </section>

            <div className="bg-indigo-50 border-l-8 border-indigo-600 p-6 rounded-r-2xl flex gap-4">
              <AlertCircle className="text-indigo-600 shrink-0" size={32} />
              <div>
                <h4 className="font-bold text-indigo-900 mb-1">Златното правило на агрегацията:</h4>
                <p className="text-indigo-800 text-sm">
                  Ако използвате агрегираща функция заедно с обикновена колона (напр. <code>SELECT category, SUM(price)</code>), 
                  <strong>задължително</strong> трябва да използвате клаузата <code>GROUP BY</code>. Ако няма други колони, SQL просто връща един ред.
                </p>
              </div>
            </div>
          </div>
        ) : (
          <div className="space-y-8 animate-in slide-in-from-bottom-4 duration-500">
            <div className="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
              <h3 className="text-lg font-bold mb-4 flex items-center gap-2 text-slate-700">
                <Database className="text-indigo-600" size={20} />
                Таблица: products (Входящи данни)
              </h3>
              <div className="overflow-x-auto">
                <table className="w-full text-sm">
                  <thead className="bg-slate-100 text-slate-500 uppercase text-xs font-bold">
                    <tr>
                      <th className="p-3 text-left">ID</th>
                      <th className="p-3 text-left">Име</th>
                      <th className="p-3 text-left">Категория</th>
                      <th className="p-3 text-right">Цена (лв)</th>
                      <th className="p-3 text-right">Наличност</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-100">
                    {inventory.map(p => (
                      <tr key={p.id} className="hover:bg-slate-50 transition-colors">
                        <td className="p-3 font-mono text-slate-400">{p.id}</td>
                        <td className="p-3 font-bold">{p.name}</td>
                        <td className="p-3"><span className="px-2 py-1 bg-slate-100 rounded-md text-xs">{p.category}</span></td>
                        <td className="p-3 text-right text-indigo-600 font-semibold">{p.price.toFixed(2)}</td>
                        <td className="p-3 text-right">{p.stock}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

            <div className="flex flex-col md:flex-row gap-8">
              <div className="flex-1 space-y-4">
                <h4 className="text-sm font-bold text-slate-400 uppercase tracking-widest px-2">Изберете функция за тест:</h4>
                <div className="grid grid-cols-1 gap-3">
                  {functions.map(f => (
                    <button
                      key={f.name}
                      onClick={() => runExample(f.name)}
                      className={`p-4 rounded-xl border-2 text-left transition-all flex items-center justify-between group ${selectedFunc === f.name ? 'border-indigo-600 bg-indigo-50 shadow-md translate-x-2' : 'border-white bg-white hover:border-slate-200 shadow-sm'}`}
                    >
                      <div className="flex items-center gap-4">
                        <div className={`${selectedFunc === f.name ? 'text-indigo-600' : 'text-slate-400 group-hover:text-indigo-400'}`}>
                          {f.icon}
                        </div>
                        <span className="font-black tracking-widest">{f.name}()</span>
                      </div>
                      <Code size={16} className={selectedFunc === f.name ? 'text-indigo-600' : 'text-slate-200'} />
                    </button>
                  ))}
                </div>
              </div>

              <div className="flex-[1.5]">
                {selectedFunc ? (
                  <div className="bg-slate-900 rounded-3xl p-8 text-white shadow-2xl h-full flex flex-col justify-between border-4 border-slate-800">
                    <div>
                      <div className="flex items-center gap-2 text-indigo-400 mb-6">
                        <Play size={20} fill="currentColor" />
                        <span className="text-xs font-black uppercase tracking-[0.2em]">Live SQL Execution</span>
                      </div>
                      
                      <div className="space-y-1 mb-8">
                        <p className="text-lg font-mono text-pink-400">SELECT <span className="text-indigo-400">{selectedFunc === 'COUNT' ? 'COUNT(*)' : `${selectedFunc}(${selectedFunc === 'SUM' ? 'stock' : 'price'})`}</span></p>
                        <p className="text-lg font-mono text-pink-400">FROM <span className="text-white">products;</span></p>
                      </div>

                      <div className="p-6 bg-slate-800/50 rounded-2xl border border-slate-700/50">
                        <p className="text-slate-500 text-xs font-bold uppercase mb-2">Резултат от сървъра:</p>
                        <div className="text-6xl font-black text-white flex items-baseline gap-3">
                          {queryResult.val}
                          <span className="text-lg font-medium text-slate-500">
                            {selectedFunc === 'COUNT' ? 'реда' : selectedFunc === 'SUM' ? 'бройки' : 'лв.'}
                          </span>
                        </div>
                      </div>
                    </div>

                    <div className="mt-8 pt-6 border-t border-slate-800 text-slate-400 text-sm italic">
                      💡 {functions.find(f => f.name === selectedFunc).details}
                    </div>
                  </div>
                ) : (
                  <div className="h-full min-h-[300px] border-4 border-dashed border-slate-200 rounded-3xl flex flex-col items-center justify-center text-slate-300">
                    <Database size={48} className="mb-4 opacity-20" />
                    <p className="font-bold">Изберете функция от менюто вляво</p>
                    <p className="text-sm">за да видите синтаксиса и резултата в реално време</p>
                  </div>
                )}
              </div>
            </div>
          </div>
        )}
      </main>

      <footer className="max-w-6xl mx-auto mt-12 pt-6 border-t border-slate-200 text-center text-slate-400 text-sm">
        Учебна програма по Бази Данни | Модул 4: Агрегиране
      </footer>
    </div>
  );
};

export default App;
